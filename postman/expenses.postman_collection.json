            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/expenses/{{expense_id}}/receipt/confirm",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "expenses",
            "{{expense_id}}",
            "receipt",
            "confirm"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"object_key\": \"{{receipt_key}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Receipt download",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/expenses/{{expense_id}}/receipt",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
