{
  "info": {
    "name": "Ahya Expense Tracker API",
    "description": "Every endpoint of the 48-hour assessment. Use returned receipt URL + fields to upload via POST before confirm.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "category_id",
      "value": ""
    },
    {
      "key": "expense_id",
      "value": ""
    },
    {
      "key": "import_job_id",
      "value": ""
    },
    {
      "key": "receipt_key",
      "value": ""
    },
    {
      "key": "expense_etag",
      "value": "\"v1\""
    },
    {
      "key": "idempotency_key",
      "value": "demo-expense-001"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/auth/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"ChangeMe!123456\",\n  \"base_currency\": \"PKR\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"ChangeMe!123456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  if(data.access_token) pm.collectionVariables.set('access_token', data.access_token);",
              "  if(data.refresh_token) pm.collectionVariables.set('refresh_token', data.refresh_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/auth/refresh",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "refresh"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  if(data.access_token) pm.collectionVariables.set('access_token', data.access_token);",
              "  if(data.refresh_token) pm.collectionVariables.set('refresh_token', data.refresh_token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/auth/logout",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "logout"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Create category",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/categories",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "categories"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Food\",\n  \"monthly_budget\": \"1000.00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  if(data.id) pm.collectionVariables.set('category_id', data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "List categories",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/categories",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "categories"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create expense",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/expenses",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "expenses"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category_id\": \"{{category_id}}\",\n  \"amount\": \"15.50\",\n  \"currency\": \"PKR\",\n  \"description\": \"Coffee\",\n  \"spent_on\": \"2026-11-17\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  if(data.id) pm.collectionVariables.set('expense_id', data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "List expenses (cursor and filters)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/expenses?limit=20&category_id={{category_id}}&q=Coffee",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "expenses"
          ],
          "query": [
            {
              "key": "limit",
              "value": "20"
            },
            {
              "key": "category_id",
              "value": "{{category_id}}"
            },
            {
              "key": "q",
              "value": "Coffee"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get expense / ETag",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/expenses/{{expense_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "expenses",
            "{{expense_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Patch expense / If-Match",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "If-Match",
            "value": "{{expense_etag}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/expenses/{{expense_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "expenses",
            "{{expense_id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Coffee (updated)\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Delete expense",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/expenses/{{expense_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "expenses",
            "{{expense_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Monthly report",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/reports/monthly?year=2026&month=11",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "reports",
            "monthly"
          ],
          "query": [
            {
              "key": "year",
              "value": "2026"
            },
            {
              "key": "month",
              "value": "11"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Notifications",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/notifications",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "notifications"
          ]
        }
      },
      "response": []
    },
    {
      "name": "CSV import",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/expenses/import",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "expenses",
            "import"
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  if(data.id) pm.collectionVariables.set('import_job_id', data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Import job status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/imports/{{import_job_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "imports",
            "{{import_job_id}}"
          ]
        }
      },
      "response": []
