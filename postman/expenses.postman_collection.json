    {
      "name": "Receipt upload URL",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/expenses/{{expense_id}}/receipt/upload-url?content_type=image/png",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "expenses",
            "{{expense_id}}",
            "receipt",
            "upload-url"
          ],
          "query": [
            {
              "key": "content_type",
              "value": "image/png"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const data = pm.response.json();",
              "  if(data.object_key) pm.collectionVariables.set('receipt_key', data.object_key);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Receipt confirm",
      "request": {
        "method": "POST",
        "header": [
