# Copy to .env for development, then replace placeholders. NEVER commit real .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/expenses
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=REPLACE_WITH_A_NEW_CRYPTOGRAPHICALLY_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_BUCKET=expense-receipts
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
IMPORT_SPOOL_DIR=.data/imports
CORS_ORIGINS=http://localhost:3000
